# ASO Node Recovery - development example configuration
# Copy to .env for local development. Never commit real secrets.

ASO_ENVIRONMENT=development
ASO_LOG_LEVEL=INFO
ASO_LOG_JSON=true
ASO_HOST=0.0.0.0
ASO_PORT=8000

# Destructive infrastructure actions are prohibited unless this is explicitly disabled later.
ASO_DRY_RUN=true

# Reserved for later phases. They are not used by Phase 1 application logic.
ASO_DATABASE_URL=postgresql+asyncpg://aso:aso_dev_only@postgres:5432/aso
ASO_TELEGRAM_BOT_TOKEN=
ASO_HETZNER_API_TOKEN=
ASO_LINODE_API_TOKEN=
ASO_MASTER_3XUI_BASE_URL=
ASO_MASTER_3XUI_USERNAME=
ASO_MASTER_3XUI_PASSWORD=
