# ASO Node Recovery - development example configuration
# Copy to .env for local development. Never commit real secrets.

ASO_ENVIRONMENT=development
ASO_LOG_LEVEL=INFO
ASO_LOG_JSON=true
ASO_HOST=0.0.0.0
ASO_PORT=8000

# Safety guard. Keep true throughout development and until an explicitly authorized production test.
ASO_DRY_RUN=true
# Second independent guard. Keep false unless a specific real infrastructure test is authorized.
ASO_ALLOW_REAL_INFRASTRUCTURE_MUTATION=false
# Third independent guard: old/current VPS deletion stays disabled even when real provisioning is enabled.
ASO_ALLOW_OLD_VPS_DELETION=false
# Required exact phrase when enabling old VPS deletion. Leave blank otherwise.
ASO_OLD_VPS_DELETE_CONFIRMATION=
ASO_MAX_REPLACEMENT_ATTEMPTS=5
ASO_MAX_TEMPORARY_SERVERS=3
ASO_MAX_CONCURRENT_REPLACEMENTS=2

# PostgreSQL
ASO_DATABASE_URL=postgresql+asyncpg://aso:aso_dev_only@postgres:5432/aso

# Monitoring. Scheduler stays opt-in in this milestone; no Check-Host call occurs on API startup.
ASO_MONITORING_SCHEDULER_ENABLED=false
ASO_CHECK_INTERVAL_SECONDS=60
ASO_FAILURE_THRESHOLD=3
ASO_RECOVERY_THRESHOLD=2
ASO_CHECK_HOST_BASE_URL=https://check-host.net
ASO_CHECK_HOST_COUNTRY_CODE=ir
ASO_CHECK_HOST_MAX_NODES=5
ASO_CHECK_HOST_MIN_SUCCESS_NODES=3
ASO_CHECK_HOST_POLL_INTERVAL_SECONDS=1.0
ASO_CHECK_HOST_RESULT_TIMEOUT_SECONDS=10.0
ASO_MONITORING_LEASE_SECONDS=45
# Optional explicit node override as JSON. Empty means discover current `ir` nodes via /nodes/hosts.
ASO_CHECK_HOST_NODES=[]

# Provider / provisioning adapters. No provider request is made while DRY_RUN=true.
ASO_HETZNER_API_BASE_URL=https://api.hetzner.cloud/v1
ASO_LINODE_API_BASE_URL=https://api.linode.com/v4
ASO_PROVISIONING_TIMEOUT_SECONDS=300
ASO_PROVISIONING_POLL_INTERVAL_SECONDS=3

# SSH / 3X-UI deployment. Disabled by default for short-lived/recycled replacement VPS IPs.
ASO_SSH_READY_TIMEOUT_SECONDS=180
ASO_SSH_POLL_INTERVAL_SECONDS=3
ASO_SSH_VERIFY_HOST_KEY=false
# Used only when ASO_SSH_VERIFY_HOST_KEY=true. Blank = managed trust store.
ASO_SSH_KNOWN_HOSTS_PATH=
# Optional stable tag such as v3.7.0. Empty follows the current stable installer behavior.
ASO_THREE_XUI_VERSION=
ASO_THREE_XUI_VERIFY_TLS=true

# Secrets. Provider records reference these environment variable names; never store the values in DB.
ASO_TELEGRAM_BOT_TOKEN=
ASO_TELEGRAM_BOT_ENABLED=false
# JSON list, e.g. [123456789]. Never leave empty when the bot is enabled.
ASO_TELEGRAM_AUTHORIZED_USER_IDS=[]
# Separate random secret (32+ chars) used to sign destructive callback confirmations.
ASO_TELEGRAM_CALLBACK_SECRET=
ASO_TELEGRAM_NOTIFICATION_CHAT_ID=
ASO_TELEGRAM_POLL_TIMEOUT_SECONDS=30
ASO_TELEGRAM_PROGRESS_INTERVAL_SECONDS=2
ASO_TELEGRAM_NOTIFICATION_INTERVAL_SECONDS=10
ASO_API_HEALTH_TIMEOUT_SECONDS=12
ASO_API_HEALTH_MAX_CONCURRENCY=8
ASO_HETZNER_API_TOKEN=
ASO_LINODE_API_TOKEN=
ASO_MASTER_3XUI_BASE_URL=
# auto: remote URL first, then same-host Docker gateway only on network timeout/failure
# remote: never fall back to the Docker host
# local-host: use Docker host gateway directly
ASO_MASTER_3XUI_CONNECTION_MODE=auto
# Optional override for same-host transport (example: http://host.docker.internal:2053/QAZ)
ASO_MASTER_3XUI_LOCAL_BASE_URL=
ASO_MASTER_3XUI_USERNAME=
ASO_MASTER_3XUI_PASSWORD=

# Replacement orchestration defaults. Runtime controls remain OFF unless enabled by an operator.
ASO_PROVIDER_RECONCILE_GRACE_SECONDS=30
ASO_REPLACEMENT_WORKER_ENABLED=false
ASO_REPLACEMENT_WORKER_INTERVAL_SECONDS=15
# Legacy compatibility flag; v1.4 runtime controls no longer require container recreation.
ASO_WORKER_SCHEDULER_ENABLED=false
ASO_REPLACEMENT_IP_CHECK_PORT=22
ASO_REPLACEMENT_JOB_LEASE_SECONDS=1800
ASO_REPLACEMENT_EMERGENCY_STOP=true
ASO_RUNTIME_SECRET_DIR=.runtime-secrets

# Master 3X-UI. Prefer API token. Username/password is the compatibility fallback.
ASO_MASTER_3XUI_API_TOKEN=
ASO_MASTER_3XUI_VERIFY_TLS=true
ASO_MASTER_3XUI_TIMEOUT_SECONDS=20


# Phase 7 backup/restore. Restore is destructive and independently disabled.
ASO_BACKUP_DIR=.backups
ASO_BACKUP_RETENTION_COUNT=14
ASO_ALLOW_DATABASE_RESTORE=false
